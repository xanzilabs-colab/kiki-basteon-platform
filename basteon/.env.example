SOS_ROUTING_URL=

DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_RESPONDER_EMAIL=
DEMO_RESPONDER_PASSWORD=

# Buddies is disabled by default. Use a random private value of at least 32 bytes.
BUDDIES_ENABLED=false
BUDDY_HMAC_SECRET=
BUDDIES_REQUIRE_VERIFICATION=false
VERIFICATION_MODE=simulation
FACE_PROOF_TTL_MINUTES=15
FACE_SESSION_TTL_SECONDS=120
FACE_MAX_FAILED_ATTEMPTS_PER_HOUR=5
FACE_LOCKOUT_MINUTES=30
FACE_MIN_MATCH_SCORE=0.9
BUDDY_DEV_VERIFIED_EMAIL=
